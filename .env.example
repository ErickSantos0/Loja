# Banco PostgreSQL persistente. Use uma conexão pooler do Neon na Vercel.
DATABASE_URL=postgresql://usuario:senha@localhost:5432/fio
# Configure uma senha exclusiva; o mínimo padrão é de 12 caracteres.
LOJA_ADMIN_USER=admin
LOJA_ADMIN_PASSWORD=
# Opcional: personalize o mínimo de caracteres (entre 5 e 256).
LOJA_ADMIN_MIN_PASSWORD_LENGTH=12
# Gere um segredo: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
LOJA_SESSION_SECRET=
LOJA_OPERATOR_NAME=Erick
